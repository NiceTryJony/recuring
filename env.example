BOT_TOKEN=bot-token
DATABASE_URL=database-url
DASHBOARD_BASE_URL=dashboard-base-url
# Необязательно: имя бота без @. Включает кнопку «Поделиться задачей»
# (в BotFather нужно настроить Main Mini App с URL <DASHBOARD_BASE_URL>/dashboard/app).
BOT_USERNAME=
# Необязательно: ваш Telegram user id (узнать у @userinfobot). Включает алерты
# о сбоях бота в личку. Без переменной алертов нет.
ADMIN_CHAT_ID=
# Необязательно, но рекомендуется: секрет подписи сессий дашборда (длинная
# случайная строка). Без неё используется BOT_TOKEN. Смена разлогинивает всех.
SESSION_SECRET=
